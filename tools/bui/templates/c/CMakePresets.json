{
  "version": 6,
  "configurePresets": [
    { "name": "default", "binaryDir": "${sourceDir}/build" }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "configuration": "Debug", "targets": ["app"] },
    { "name": "release", "configurePreset": "default", "configuration": "Release", "targets": ["app"] }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "default" }
      ]
    }
  ]
}
