---
import Icon from "../site/Icon.astro";

interface Props {
  id: string;
  kicker: string;
  title: string;
  lede?: string;
  /** A Phosphor icon next to the kicker. */
  icon?: string;
  class?: string;
}
const { id, kicker, title, lede, icon, class: className } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class:list={["scroll-mt-16", className]}>
  <header class="flex flex-col gap-3 border-b border-border px-5 py-10 sm:px-10 md:py-14 lg:flex-row lg:items-end lg:justify-between lg:gap-16" data-reveal>
    <div class="flex flex-col gap-3">
      <p class="kicker inline-flex items-center gap-2 text-link">
        {icon && <Icon name={icon} weight="duotone" size={15} />}
        {kicker}
      </p>
      <h2 id={`${id}-title`} class="max-w-[22ch] text-balance text-3xl font-medium uppercase leading-[1.05] tracking-[-0.02em] md:text-[2.6rem]">
        {title}
      </h2>
    </div>
    {lede && <p class="max-w-[48ch] text-pretty text-[16px] leading-7 text-muted lg:pb-1 lg:text-right">{lede}</p>}
  </header>
  <slot />
</section>
