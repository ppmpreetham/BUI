---
// BUI's mark: public/logo.png (generated from the repo's public/Logo.png).
// The letters are the wordmark, so `size` is the logo's height.
import { href } from "../../lib/docs";

interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
const width = Math.round((size * 940) / 769);
---

<img src={href("logo.png")} width={width} height={size} alt="BUI" class:list={["shrink-0 select-none", className]} draggable="false" />
