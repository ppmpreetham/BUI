{
  "name": "@blender-ui/react",
  "version": "0.4.0",
  "description": "React renderer for BUI: Blender's UI in native windows from JSX, with React's hooks backed by signals. Node.js and Bun.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "default": "./jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-dev-runtime.d.ts",
      "default": "./jsx-dev-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "hooks.js",
    "index.d.ts",
    "jsx-runtime.js",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.js",
    "jsx-dev-runtime.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test",
    "prepack": "node -e \"const fs=require('fs');for(const f of ['LICENSE','THIRD_PARTY_NOTICES.md'])fs.copyFileSync('../../'+f,f)\"",
    "postpack": "node -e \"const fs=require('fs');for(const f of ['LICENSE','THIRD_PARTY_NOTICES.md'])fs.rmSync(f,{force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@blender-ui/native": "^0.4.0",
    "react-reconciler": "0.34.0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "react": "19.3.1"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppmpreetham/BUI.git",
    "directory": "bindings/react"
  },
  "homepage": "https://bui.preetham.top",
  "bugs": {
    "url": "https://github.com/ppmpreetham/BUI/issues"
  },
  "keywords": [
    "react",
    "renderer",
    "react-reconciler",
    "signals",
    "blender",
    "ui",
    "desktop",
    "native",
    "tailwind",
    "bun"
  ]
}
